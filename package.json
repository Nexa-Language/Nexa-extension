{
  "name": "nexa-lang",
  "displayName": "Nexa",
  "description": "Nexa 3.0 native Open Programs authoring, evidence and exact patch review; 2.4 compatibility",
  "version": "0.3.0",
  "publisher": "Nexa-Language",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexa-Language/Nexa-extension"
  },
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:nexa",
    "onTaskType:nexa",
    "onView:nexa.openPrograms"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nexa",
        "aliases": [
          "Nexa",
          "nexa"
        ],
        "extensions": [
          ".nx",
          ".nxlib"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nexa-secrets",
        "aliases": [
          "Nexa Secrets",
          "nexa-secrets"
        ],
        "extensions": [
          ".nxs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nexa",
        "scopeName": "source.nexa",
        "path": "./syntaxes/nexa.tmLanguage.json"
      },
      {
        "language": "nexa-secrets",
        "scopeName": "source.nexa.secrets",
        "path": "./syntaxes/secrets.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "nexa.build",
        "title": "Build",
        "icon": "$(build)",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.run",
        "title": "Run",
        "icon": "$(play)",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.harnessCheck",
        "title": "Harness Check",
        "icon": "$(check)",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.validate",
        "title": "Validate",
        "icon": "$(checklist)",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.inspect",
        "title": "Inspect Structure",
        "category": "Nexa",
        "icon": "$(symbol-class)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.stop",
        "title": "Stop Running Tasks",
        "category": "Nexa",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nexa.open.check",
        "title": "Check Open Program",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.buildLocked",
        "title": "Build Locked Open Program",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.resolve",
        "title": "Resolve Goal",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.revise",
        "title": "Revise and Activate Program",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.maintain",
        "title": "Maintain Repository",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.status",
        "title": "Refresh Open Program Status",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.cancel",
        "title": "Cancel Activity",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.answer",
        "title": "Answer Clarification",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.syncSource",
        "title": "Synchronize Clarification Source",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.proposal",
        "title": "Review Exact Patch",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.apply",
        "title": "Authorize and Apply Exact Patch",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.recover",
        "title": "Recover Open Program or Patch",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.resumeApply",
        "title": "Resume Exact Patch Application",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.capsuleImport",
        "title": "Import Capsule",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "nexa.open.capsuleExport",
        "title": "Export Activity Capsule",
        "category": "Nexa",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nexa.run",
          "group": "navigation",
          "when": "resourceLangId == nexa"
        },
        {
          "command": "nexa.build",
          "group": "navigation",
          "when": "resourceLangId == nexa"
        },
        {
          "command": "nexa.stop",
          "group": "navigation",
          "when": "nexa.hasRunningTasks"
        },
        {
          "command": "nexa.inspect",
          "group": "navigation@3",
          "when": "resourceLangId == nexa"
        }
      ],
      "editor/context": [
        {
          "command": "nexa.build",
          "group": "nexa",
          "when": "resourceLangId == nexa"
        },
        {
          "command": "nexa.run",
          "group": "nexa",
          "when": "resourceLangId == nexa"
        },
        {
          "command": "nexa.harnessCheck",
          "group": "nexa",
          "when": "resourceLangId == nexa"
        }
      ],
      "view/title": [
        {
          "command": "nexa.open.status",
          "when": "view == nexa.openPrograms",
          "group": "navigation"
        },
        {
          "command": "nexa.open.check",
          "when": "view == nexa.openPrograms",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nexa.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "resourceLangId == nexa"
      },
      {
        "command": "nexa.run",
        "key": "f5",
        "mac": "f5",
        "when": "resourceLangId == nexa"
      }
    ],
    "configuration": {
      "title": "Nexa",
      "properties": {
        "nexa.executablePath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "CLI executable only, without arguments. Supports paths with spaces. Empty uses the legacy nexa.executable setting."
        },
        "nexa.executableArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Arguments before the Nexa subcommand. For uv: [\"run\", \"--project\", \"/path/to/Nexa\", \"nexa\"]. No shell expansion."
        },
        "nexa.executable": {
          "type": "string",
          "default": "nexa",
          "scope": "resource",
          "description": "Legacy executable or quoted command. Prefer executablePath and executableArgs.",
          "markdownDeprecationMessage": "Use `nexa.executablePath` and `nexa.executableArgs`. Existing common forms remain supported."
        },
        "nexa.harnessMode": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "strict"
          ],
          "default": "warn",
          "scope": "resource",
          "description": "Harness mode for build, run and diagnostics."
        },
        "nexa.proxyUrl": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional HTTP/HTTPS proxy for explicit build and run tasks. Empty inherits the environment."
        },
        "nexa.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Check saved Nexa source files on open and save in trusted workspace folders."
        },
        "nexa.diagnostics.delayMs": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "maximum": 5000,
          "scope": "resource",
          "description": "Debounce time for automatic checks, in milliseconds."
        },
        "nexa.checkTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "scope": "resource",
          "description": "Deadline for each validate, harness-check and inspect process."
        },
        "nexa.taskTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 1000,
          "maximum": 86400000,
          "scope": "resource",
          "description": "Deadline for build and run tasks. Stop is always available."
        },
        "nexa.maxOutputBytes": {
          "type": "number",
          "default": 4194304,
          "minimum": 1024,
          "maximum": 67108864,
          "scope": "resource",
          "description": "Combined stdout/stderr limit per CLI process. Exceeding it stops the process."
        },
        "nexa.open.environment": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Compiler environment JSON path, relative to the owning workspace root. Required for explicit build, resolve, run and apply."
        },
        "nexa.open.state": {
          "type": "string",
          "default": ".nexa/open-programs.sqlite3",
          "scope": "resource",
          "description": "Nexa 3.0 state database, relative to the owning workspace root."
        },
        "nexa.open.programId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Program identity. Empty uses the source filename without its extension."
        },
        "nexa.open.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Explicit Python executable containing Nexa 3.0.0 for the packaged read-only SDK bridge. Never inferred or installed."
        },
        "nexa.open.dockerContext": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional Docker context for explicit Author/build/run operations."
        },
        "nexa.open.pythonArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Arguments preceding the packaged Python bridge. Supports ${workspaceFolder}; no shell expansion."
        },
        "nexa.open.maxModelCalls": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 100,
          "scope": "resource",
          "description": "Maximum model calls for each explicit resolution."
        },
        "nexa.open.maxTokens": {
          "type": "integer",
          "default": 20000,
          "minimum": 1,
          "maximum": 10000000,
          "scope": "resource",
          "description": "Cumulative token budget."
        },
        "nexa.open.timeoutSeconds": {
          "type": "integer",
          "default": 120,
          "minimum": 1,
          "maximum": 3600,
          "scope": "resource",
          "description": "Explicit resolution deadline in seconds."
        },
        "nexa.open.capsule": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Exact imported capsule digest explicitly selected for run/maintenance. Empty uses normal resolution."
        }
      }
    },
    "snippets": [
      {
        "language": "nexa",
        "path": "./snippets/nexa.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "nexa",
        "required": [
          "command",
          "file"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "run"
            ],
            "description": "Nexa action."
          },
          "file": {
            "type": "string",
            "description": "Source path, relative to this task’s workspace folder or absolute."
          }
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "nexa.openPrograms",
          "name": "Nexa Open Programs",
          "when": "isWorkspaceTrusted"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/*.environment.json"
        ],
        "url": "./schemas/3.0/environment.schema.json"
      },
      {
        "fileMatch": [
          "**/*.nx.lock"
        ],
        "url": "./schemas/3.0/lock.schema.json"
      },
      {
        "fileMatch": [
          "**/*.capsule.json"
        ],
        "url": "./schemas/3.0/capsule.schema.json"
      },
      {
        "fileMatch": [
          "**/*.program.json"
        ],
        "url": "./schemas/3.0/program.schema.json"
      },
      {
        "fileMatch": [
          "**/*.patch.json"
        ],
        "url": "./schemas/3.0/patch.schema.json"
      }
    ]
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting and snippets work in Restricted Mode. CLI execution, diagnostics and inspection require Workspace Trust.",
      "restrictedConfigurations": [
        "nexa.executable",
        "nexa.executablePath",
        "nexa.executableArgs",
        "nexa.proxyUrl",
        "nexa.open.environment",
        "nexa.open.state",
        "nexa.open.programId",
        "nexa.open.pythonPath",
        "nexa.open.dockerContext",
        "nexa.open.pythonArgs",
        "nexa.open.maxModelCalls",
        "nexa.open.maxTokens",
        "nexa.open.timeoutSeconds",
        "nexa.open.capsule"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Nexa requires saved files on the extension host filesystem."
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm compile && node --test test/*.test.cjs",
    "test:host": "pnpm compile && node scripts/test-host.cjs",
    "test:cli": "pnpm compile && node scripts/test-cli.cjs",
    "vscode:prepublish": "tsc -p tsconfig.json",
    "package": "vsce package --no-dependencies --out nexa-lang-0.3.0.vsix",
    "check": "pnpm run typecheck && pnpm test",
    "verify:package": "node scripts/verify-package.cjs",
    "test:open": "pnpm compile && node scripts/test-open.cjs",
    "test:oci": "pnpm compile && node scripts/test-open.cjs --oci",
    "test:host:open": "pnpm compile && node scripts/test-host-open.cjs"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.7.3",
    "vscode-textmate": "9.2.0",
    "vscode-oniguruma": "2.0.1"
  }
}
